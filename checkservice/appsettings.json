{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ServiceChecker": {
    "CheckIntervalSeconds": 10,
    "Services": ["Spooler"]
  },
  "Webhook": {
    "Provider": "generic",
    "Url": ""
  },
  "ServerInfo": {
    "ServerName": "",
    "CompanyName": ""
  },
  "SystemHealthCheck": {
    "Enabled": false,
    "CpuThreshold": 85.0,
    "MemoryThreshold": 85.0,
    "DiskThreshold": 90.0,
    "DiskDrive": "C"
  },
  "FileIntegrityCheck": {
    "Enabled": false,
    "FilesToMonitor": []
  }
}
